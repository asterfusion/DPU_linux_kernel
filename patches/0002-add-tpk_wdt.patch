--- a/linux.config
+++ b/linux.config
@@ -3950,6 +3950,7 @@ CONFIG_WATCHDOG_OPEN_TIMEOUT=0
 # USB-based Watchdog Cards
 #
 # CONFIG_USBPCWATCHDOG is not set
+CONFIG_TERA_WDT=m
 CONFIG_SSB_POSSIBLE=y
 # CONFIG_SSB is not set
 CONFIG_BCMA_POSSIBLE=y
